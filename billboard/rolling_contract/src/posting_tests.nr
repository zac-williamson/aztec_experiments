}
unconstrained fn configure_funded_bok(env: TestEnvironment, board: AztecAddress, moderator: AztecAddress, user: AztecAddress) -> AztecAddress {
    let mut env = env;
    let bok = env.deploy("../experiments/private-bok@private_bok/PrivateBok").with_public_initializer(moderator, PrivateBok::interface().init(board, moderator, 1, 1));
    let portal = EthAddress::from_field(567);
    env.call_public(moderator, PrivateBok::at(bok).set_portal(portal));
    env.call_public(moderator, RollingBoard::at(board).configure_plugin(77, bok, true));
    let recipient = recipient_commitment(1, portal, bok, 1, user, 301);
    let content = sha256_to_field(words("PLUGIN_CREDIT_V1", [1, 567, bok.to_field(), 1, recipient, 1000]));
    let leaf = env.send_l1_to_l2_message(content, 302, portal, bok);
    env.call_private(user, PrivateBok::at(bok).claim(1000, 301, 302, leaf));
    assert_eq(env.execute_utility(PrivateBok::at(bok).balance_of(user)), 1000);
    bok
}
#[test]
unconstrained fn actual_private_bok_callback_activates_exact_funded_named_post() {
    let (env, board, moderator, alice, _) = setup(); let chain = fund(env, board, alice, 101);
    let bok = configure_funded_bok(env, board, moderator, alice);
    env.call_private(alice, RollingBoard::at(board).register_name(fixed("John"), 4, fixed("Doe"), 3));
    let mut d = draft(); d.name_id = name_id(fixed("John"), 4, fixed("Doe"), 3);
    let target = invocation_target(1, 1, board, bok, 201, d);
    env.call_private(alice, PrivateBok::at(bok).authorize_request(401, target, 600));
    env.mine_block_at(env.last_block_timestamp() + 11);
    env.call_private(alice, RollingBoard::at(board).post_with_bok(chain, 201, d, Option::none(), Option::none(), 77, 401));
    let request = env.view_public(PrivateBok::at(bok).request(401));
    assert_eq(request.state, 2); assert_eq(request.invocation_hash, target);
    assert_eq(request.available, 600); assert_eq(request.charged, 0);
    assert_eq(env.execute_utility(PrivateBok::at(bok).balance_of(alice)), 400);
    assert_eq(env.view_public(RollingBoard::at(board).get_post_count()), 1);
    let (exists, record, _, _, _) = env.view_public(RollingBoard::at(board).get_post(post_id(board, 201)));
    assert(exists); assert_eq(record.name_id, d.name_id);
    let deposit = env.execute_utility(RollingBoard::at(board).get_deposit_info(alice, chain));
    assert_eq(deposit[5], 1); assert_eq(deposit[8], 1);
    env.call_private(alice, RollingBoard::at(board).authenticate_name(d.name_id));
}
