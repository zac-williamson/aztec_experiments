    let mut deadlines = [0; 8]; deadlines[0] = 115;
    let mut flags = [false; 8]; flags[0] = true;
    assert_eq(crate::admission::thread_ready_time(100, 100, 10, 3, 10, 3, 1, deadlines, flags), 140);
}
