#[test]
unconstrained fn bot_reply_to_nested_invocation_keeps_original_thread_root() {
    let (env, board, op, alice, bob) = setup();
    let alice_chain = fund(env, board, alice, 801);
    let root = publish(env, board, alice, alice_chain, 200, draft());
    let bob_chain = fund(env, board, bob, 802);
    let bok = configure_funded_bok(env, board, op, bob);
    let mut d = draft(); d.parent = root; d.root_reference = root;
    env.call_private(bob, PrivateBok::at(bok).authorize_request(401, invocation_target(1, 1, board, bok, 201, d), 600));
    env.mine_block_at(env.last_block_timestamp() + 11);
    env.call_private(bob, RollingBoard::at(board).post_with_bok(bob_chain, 201, d, Option::none(), Option::none(), 77, 401));
    env.call_public(op, PrivateBok::at(bok).settle(401, 0, 0, 999));
    env.call_public(op, PrivateBok::at(bok).publish_reply(401, 77, text("Done"), 4, 1, 0));
    let (exists, record, _, _, _) = env.view_public(RollingBoard::at(board).get_post(crate::posting::bot_reply_id(board, bok, 401)));
    assert(exists); assert_eq(record.parent, post_id(board, 201)); assert_eq(record.root, root);
    assert(record.parent != record.root); assert_eq(record.kind, 4);
}
#[test]
fn reply_callback_serialization_has_exact_37_fields() {
    let board = AztecAddress::from_field(42); let message: [Field; 32] = text("Done");
    let expected = [401, 77].concat(message).concat([4, 1, 0]);
    assert_eq(RollingBoard::at(board).publish_plugin_reply(401, 77, message, 4, 1, 0).args, expected);
    assert_eq(PrivateBok::at(board).publish_reply(401, 77, message, 4, 1, 0).args, expected);
}

use aztec::keys::getters::{get_nhk_app, get_public_keys};
use aztec::note::{NoteMessage, lifecycle::create_note, note_getter_options::NoteGetterOptions,
    note_interface::{NoteHash, NoteProperties}};
use aztec::state_vars::{PrivateSet, OwnedStateVariable};
use aztec::protocol::constants::MAX_NOTE_HASHES_PER_CALL;
use crate::RollingBoard::{DepositNote, PostNote};
use crate::admission::{post_link, SequenceState};

// Same layered C04 boundary on current RollingBoard: one actual post establishes
// storage identity, native TXE seeds 1,001 linked notes in batches of at most 16,
// then actual calls authenticate the tail, continue posting and screen to exit.
// This is not 1,002 published transactions or generated proofs.
#[test]
unconstrained fn history_seeded_1002_tail_authentication_and_exit() {
    let (mut env, board, _, owner, _) = setup();
    let chain = fund(env, board, owner, 101);
    let _ = publish(env, board, owner, chain, 201, draft());
    let (first, _) = env.execute_utility(RollingBoard::at(board).get_screen_hints(owner, chain));
    let first = first.unwrap_unchecked();
    let post_slot = first.storage_slot;
    // These are the actual generated layout slots; the first authentic note
    // checks the post slot and popping the authentic deposit checks its slot.
    assert_eq(post_slot, RollingBoard::storage_layout().posts.slot);
    let deposit_slot = RollingBoard::storage_layout().deposits.slot;
    assert_eq(PostNote::properties().deposit_chain_id.index, 1);
    assert_eq(PostNote::properties().deposit_chain_id.length, 32);
    assert_eq(PostNote::properties().previous_link.index, 5);
    assert_eq(PostNote::properties().previous_link.length, 32);
    let initial = env.execute_utility(RollingBoard::at(board).get_deposit_info(owner, chain));
    let link_secret = env.utility_context_at(board, |_| get_nhk_app(get_public_keys(owner).npk_m_hash));
    let mut previous_link = initial[4];
    let mut screened_link: Field = 0;
    let timestamp = first.note.anchor_timestamp;
    std::static_assert(MAX_NOTE_HASHES_PER_CALL >= 16, "Fixture batch exceeds protocol limit");
    for batch in 0..63 {
        let (messages, last, screened) = env.private_context_at(board, |context| {
            let mut messages: BoundedVec<NoteMessage<PostNote>, 16> = BoundedVec::new();
            let mut previous = previous_link;
            let mut screened = screened_link;
            for i in 0..16 {
                let sequence = 2 + batch as u64 * 16 + i as u64;
                if sequence <= 1002 {
                    let note = PostNote { schema_version: 1, deposit_chain_id: chain,
                        sequence, post_id: 0, anchor_timestamp: timestamp,
                        previous_link: previous, is_dummy: true };
                    let message = create_note(context, owner, post_slot, note);
                    let new_note = message.get_new_note();
                    let hash = note.compute_note_hash(owner, post_slot, new_note.randomness);
                    previous = post_link(board, owner, chain, sequence, hash, link_secret);
                    if sequence == 1000 { screened = previous; }
                    messages.push(message);
                }
            }
            (messages, previous, screened)
        });
        previous_link = last;
        screened_link = screened;
        for i in 0..messages.len() {
            env.discover_note_at(board, messages.get_unchecked(i));
        }
    }
    assert(screened_link != 0); assert(previous_link != screened_link);
    let replacement = env.private_context_at(board, |context| {
        let deposits: PrivateSet<DepositNote, _> = PrivateSet::new(context, deposit_slot, owner);
        let notes = deposits.pop_notes(NoteGetterOptions::<DepositNote, 8, Field, Field>::new().set_limit(1));
        assert_eq(notes.len(), 1);
        let mut deposit = notes.get_unchecked(0);
        assert_eq(deposit.deposit_chain_id, chain);
        assert_eq(deposit.head_link, initial[4]);
        deposit.head_link = previous_link;
        deposit.screened_link = screened_link;
        deposit.sequences = SequenceState { head_sequence: 1002, screened_sequence: 1000, last_real_sequence: 1 };
        deposits.insert(deposit)
    });
    env.discover_note_at(board, replacement);
    let (child, grandchild) = env.execute_utility(RollingBoard::at(board).get_screen_hints(owner, chain));
    assert(child.is_some()); assert(grandchild.is_some());
    assert_eq(child.unwrap_unchecked().note.sequence, 1001);
    assert_eq(grandchild.unwrap_unchecked().note.sequence, 1002);
    assert_eq(child.unwrap_unchecked().note.previous_link, screened_link);
    env.mine_block_at(env.last_block_timestamp() + 201);
    env.call_private(owner, RollingBoard::at(board).post(chain, 202, draft(), child, grandchild));
    let after = env.execute_utility(RollingBoard::at(board).get_deposit_info(owner, chain));
    assert_eq(after[5], 1003); assert_eq(after[7], 1002); assert_eq(after[8], 1003);
    assert_eq(env.view_public(RollingBoard::at(board).get_post_count()), 2);
    env.mine_block_at(env.last_block_timestamp() + 201);
    let (last, none) = env.execute_utility(RollingBoard::at(board).get_screen_hints(owner, chain));
    assert_eq(last.unwrap_unchecked().note.sequence, 1003); assert(none.is_none());
    env.call_private(owner, RollingBoard::at(board).screen(chain, last, none));
    env.mine_block_at(env.last_block_timestamp() + 201);
    env.call_private(owner, RollingBoard::at(board).withdraw(chain));
    assert_eq(env.execute_utility(RollingBoard::at(board).get_deposit_info(owner, chain)), [0; 11]);
}

fn thread_drafts(board: AztecAddress, nonces: [Field; 4], count: u32, first: PostDraft) -> [PostDraft; 4] {
    let mut drafts = [first; 4];
    let root = if first.parent == 0 { post_id(board, nonces[0]) } else { first.root_reference };
    for i in 1..4 {
        if i < count {
            drafts[i].parent = post_id(board, nonces[i - 1]);
            drafts[i].root_reference = root;
            drafts[i].kind = 1; drafts[i].reference = 0;
        }
    }
    drafts
}
#[test]
fn thread_identity_is_derived_and_links_are_canonical() {
    let board = AztecAddress::from_field(42); let nonces = [201, 202, 203, 204];
    let drafts = thread_drafts(board, nonces, 4, draft());
    let ids = crate::posting::validate_thread(board, nonces, drafts, 4, [0; 4], [0; 4]);
    for i in 0..4 { assert_eq(ids[i], post_id(board, nonces[i])); }
}
