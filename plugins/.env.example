# Copy to plugins/.env (gitignored). Never put secrets in descriptors or prompts.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.6
# Operator's explicit ETH-to-compute allowance, not an onchain exchange rate.
PLUGIN_USD_PER_ETH=2000
# Optional. Production: selected-repository GitHub App installation token.
GITHUB_TOKEN=
PLUGIN_REPOSITORY=zac-williamson/aztec_experiments
PLUGIN_GITHUB_WRITES=false

# Set true to use real application proofs on the same local transaction path.
PLUGIN_PROOFS=false
# Optional LAN hostname/IP to advertise in the pinned descriptor.
PLUGIN_PUBLIC_HOST=
