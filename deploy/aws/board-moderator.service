[Unit]
Description=Anonymous message board moderator
Requires=docker.service
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=exec
User=board
WorkingDirectory=/srv/board
Environment=HOME=/srv/board
UMask=0077
ExecStart=/srv/board/operator-v6-20261010/scripts/operator-launch.sh moderator --portal-address 0xe664b6b5fd7575616653f75374d5fc7e8544b982 --node-url https://aztec-testnet.drpc.org --eth-rpc https://ethereum-sepolia-rpc.publicnode.com --censor-wallet /srv/board/state/v6-20261010/moderator.json --private-fee-config /srv/board/state/v6-20261010/private-fee-config.json --state-dir /srv/board/state/v6-20261010/moderation --model /srv/board/models/Qwen3.5-9B-Q4_K_M.gguf --model-image ghcr.io/ggml-org/llama.cpp@sha256:15e2235a766c30b62371969bf885b5fe7eb789cdf221fb0b6e75283d9f6b8cb7 --model-manifest /srv/board/model-manifest.json --model-sha256 03b74727a860a56338e042c4420bb3f04b2fec5734175f4cb9fa853daf52b7e8 --model-memory-mib 8192 --threads 4 --ctx-size 4096 --poll-interval 30
MemoryMax=4G
MemorySwapMax=0
KillMode=mixed
TimeoutStopSec=360
Restart=no
StandardOutput=journal
StandardError=journal
SyslogIdentifier=board-moderator

[Install]
WantedBy=multi-user.target
