[Unit]
Description=Private CloudFront entry point for board prover
After=network-online.target board-prover.service
Wants=network-online.target

[Service]
User=board-prover
Group=board-prover
ExecStart=/usr/local/bin/caddy run --config /etc/board-prover/Caddyfile --adapter caddyfile
Restart=no
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
MemoryMax=128M
TasksMax=64
LimitCORE=0

[Install]
WantedBy=multi-user.target
