// Independent Noir construction from scalar inputs in commitments-v1.json.
// Expected bytes/hashes are frozen known answers; the preimage under test is
// constructed by the pinned Field serializer and explicit domain/policy bytes.
use aztec::protocol::hash::sha256_to_field;

fn encode_words<let N: u32, let D: u32>(domain: str<D>, words: [Field; N]) -> [u8; 32 + N * 32] {
    std::static_assert(D <= 32, "Domain must fit one word");
    let mut output: [u8; 32 + N * 32] = [0; 32 + N * 32];
    let ascii = domain.as_bytes();
    for i in 0..D { output[i] = ascii[i]; }
    for i in 0..N {
        let bytes: [u8; 32] = words[i].to_be_bytes();
        for j in 0..32 { output[32 + i * 32 + j] = bytes[j]; }
    }
    output
}

fn encode_policy<let P: u32>(board: Field, policy: [u8; P]) -> [u8; 128 + P] {
    let prefix = encode_words("AZTEC_BB_POLICY_V1", [1, board, P as Field]);
    let mut output: [u8; 128 + P] = [0; 128 + P];
    for i in 0..128 { output[i] = prefix[i]; }
    for i in 0..P { output[128 + i] = policy[i]; }
    output
}


