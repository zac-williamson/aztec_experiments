{
  "dependencies": {
    "@aztec/accounts": "5.2.0",
    "@aztec/aztec.js": "5.2.0",
    "@aztec/bb.js": "5.2.0",
    "@aztec/entrypoints": "5.2.0",
    "@aztec/foundation": "5.2.0",
    "@aztec/kv-store": "5.2.0",
    "@aztec/protocol-contracts": "5.2.0",
    "@aztec/pxe": "5.2.0",
    "@aztec/standard-contracts": "5.2.0",
    "@aztec/stdlib": "5.2.0",
    "@aztec/wallet-sdk": "5.2.0",
    "ethers": "6.17.0",
    "fake-indexeddb": "6.2.5",
    "venice-x402-client": "0.2.0"
  },
  "devDependencies": {
    "@aztec/aztec": "5.2.0",
    "@aztec/cli": "5.2.0",
    "@aztec/cli-wallet": "5.2.0",
    "@aztec/txe": "5.2.0",
    "esbuild": "0.25.12",
    "esbuild-plugin-polyfill-node": "0.3.0",
    "playwright": "1.63.0"
  },
  "name": "aztec-anonymous-billboard",
  "private": true,
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "build:sdk": "node scripts/build-sdk.mjs",
    "test:moderation": "bash censor-daemon/run_tests.sh",
    "bootstrap:noir": "node scripts/bootstrap-noir.mjs",
    "build:contracts": "node scripts/build-contracts.mjs",
    "build:apps": "node apps/build.mjs",
    "check:artifacts": "node scripts/check-artifacts.mjs",
    "build": "npm run build:contracts && npm run build:sdk && npm run build:crs && npm run build:apps",
    "test:sdk-browser": "node scripts/test-sdk-browser.mjs --with-crs",
    "test:noir": "node scripts/test-noir.mjs",
    "test:build": "node --test scripts/test-artifacts.mjs scripts/test-sdk-manifest.mjs scripts/test-noir-dependencies.mjs scripts/test-crs-build.mjs scripts/test-crs-consumers.mjs scripts/test-process-lifecycle.mjs",
    "build:crs": "node scripts/build-crs.mjs",
    "test:cli-sdk": "node scripts/test-cli-sdk.mjs",
    "test:dependencies": "node --test scripts/test-dependency-*.mjs",
    "test:c01-clients": "node --test scripts/test-c01-user.mjs scripts/test-c01-deploy-activation.mjs scripts/test-artifacts.mjs",
    "test:application:bridge": "node scripts/test-c01-application.mjs private-fees",
    "test:application:unit": "npm run test:c01-clients && npm run test:noir && npm run test:portal",
    "test:portal": "cd billboard/portal && FOUNDRY_PROFILE=regression forge test --offline",
    "test:harness": "node scripts/test-harness.mjs harness",
    "test:components": "node scripts/test-harness.mjs components",
    "test:e2e": "node scripts/test-c01-application.mjs",
    "test:plugins": "node --test plugins/test/*.test.mjs",
    "test:plugins:e2e": "NODE_BACKEND=js LOG_LEVEL=error node plugins/devnet/test-e2e.mjs",
    "dev:plugins": "NODE_BACKEND=js node --env-file=plugins/.env plugins/devnet/start.mjs",
    "bot:serve": "NODE_BACKEND=js node --env-file=plugins/.env plugins/main.mjs",
    "bot:venice": "node --env-file=plugins/.env plugins/venice-cli.mjs",
    "test:plugins:live": "NODE_BACKEND=js node --env-file=plugins/.env plugins/devnet/live.mjs"
  },
  "overrides": {
    "systeminformation": "5.31.7",
    "ws": "8.21.0",
    "undici": "6.28.1",
    "tmp": "0.2.7",
    "qs": "6.16.0",
    "uuid": "11.1.1",
    "@opentelemetry/propagator-jaeger": "2.9.0"
  }
}
